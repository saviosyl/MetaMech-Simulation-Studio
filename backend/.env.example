NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (use either DATABASE_URL or individual DB_* vars)
# DATABASE_URL=postgresql://user:password@localhost:5432/metamech_studio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metamech_studio
DB_USER=postgres
DB_PASSWORD=replace_with_secure_password
DB_SSL=false

# Frontend URL used for reset-password links
FRONTEND_URL=http://localhost:5173

# Development only: expose reset link in forgot-password response
EXPOSE_DEV_RESET_LINK=false
