NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Database (use either DATABASE_URL or individual DB_* vars)
# DATABASE_URL=postgresql://user:password@localhost:5432/metamech_studio
DB_HOST=localhost
DB_PORT=5432
DB_NAME=metamech_studio
DB_USER=postgres
# For local docker-compose default: DB_PASSWORD=postgres
DB_PASSWORD=replace_with_secure_password
DB_SSL=false

# Frontend URL used for reset-password links
FRONTEND_URL=http://localhost:5173
# Production example:
# FRONTEND_URL=https://app.metamechsolutions.com
# Optional extra CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Production example:
# CORS_ORIGINS=https://app.metamechsolutions.com

# Development only: expose reset link in forgot-password response
EXPOSE_DEV_RESET_LINK=false

# Development only: expose verification link in register/resend response
EXPOSE_DEV_VERIFICATION_LINK=false

# Email verification token TTL (hours)
EMAIL_VERIFICATION_TOKEN_HOURS=24

# Salt used to hash trial identity keys (email-based)
TRIAL_IDENTITY_SALT=replace_with_random_salt

# Optional: seed/refresh test admin account (manual script)
TEST_ADMIN_EMAIL=saviosyl@gmail.com
TEST_ADMIN_PASSWORD=replace_with_strong_test_password
TEST_ADMIN_DISPLAY_NAME=MetaMech Test Admin
TEST_ADMIN_ROLE=admin
TEST_ADMIN_SUBSCRIPTION_DAYS=3650
TEST_ADMIN_RESET_PASSWORD=false

# OEM GitHub sync (used by /admin/oem-library/sync)
# Personal access token must have repo contents write access.
GITHUB_TOKEN=replace_with_github_token
GITHUB_OEM_OWNER=saviosyl
GITHUB_OEM_REPO=MetaMech-Simulation-Studio
GITHUB_OEM_BRANCH=main
GITHUB_OEM_LIBRARY_PATH=oem-library
# Optional comma-separated allowlist for OEM admin sync (in addition to admin roles)
OEM_ADMIN_EMAILS=saviosyl@gmail.com
