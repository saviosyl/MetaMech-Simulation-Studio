<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:clr="clr-namespace:System;assembly=mscorlib"
    xmlns:views="clr-namespace:FlexLink.Tacton.Views;assembly=FlexLink.Tacton">
    <!--
        Styling only for the tacton API window. Other styling for FLDT is to be placed in Resources.xaml
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCToggleSwitch.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCButton.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCCheckBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCGrid.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCLable.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.Shared;component/Controls/VCThemes/VCExpander.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.FlexLink;component/HackedVCComboBox.xaml" />
        <ResourceDictionary Source="pack://application:,,,/UX.FlexLink.Core;component/Resources/FLGroupBox.xaml" />

        <ResourceDictionary>
            <clr:Double x:Key="ControlMinHeigth">18</clr:Double>
            <Thickness
                x:Key="ControlPadding"
                Bottom="2"
                Left="5"
                Right="5"
                Top="2" />

            <Style x:Key="BorderStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeFgM2Brush}" />
                <Setter Property="CornerRadius" Value="2" />
            </Style>

            <Style TargetType="views:TactonConfiguratorDialog">
                <Setter Property="Foreground" Value="{DynamicResource ThemeFgBrush}" />
                <Setter Property="Background" Value="{DynamicResource MessageBoxNormalBackgroundBrush}" />
            </Style>

            <Style BasedOn="{StaticResource VCButtonStyle}" TargetType="Button">
                <Setter Property="MinHeight" Value="{StaticResource ControlMinHeigth}" />
                <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
            </Style>

            <Style BasedOn="{StaticResource VCCheckBoxStyle}" TargetType="CheckBox" />

            <Style BasedOn="{StaticResource VCComboBoxStyle}" TargetType="ComboBox" />
            <Style BasedOn="{StaticResource {x:Type Expander}}" TargetType="Expander">

                <Setter Property="Foreground" Value="{DynamicResource ThemeFgBrush}" />
            </Style>

            <Style BasedOn="{StaticResource VCTextBlockLargerLabelStyle}" TargetType="TextBlock">
                <Setter Property="Height" Value="Auto" />
                <Setter Property="MinHeight" Value="{StaticResource ControlMinHeigth}" />
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="true">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--  Predefined styles in Tacton API styles  -->
            <Style
                x:Key="HeaderTextBlockStyle"
                BasedOn="{StaticResource VCTextBlockLargestLabelStyle}"
                TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ThemeFgBrush}" />
                <Setter Property="Padding" Value="0,0,0,0" />
                <Setter Property="MinHeight" Value="{StaticResource ControlMinHeigth}" />
            </Style>

            <Style
                x:Key="LockButtonStyle"
                BasedOn="{StaticResource VCBorderlessIconContentButtonStyle}"
                TargetType="Button" />

            <Style x:Key="ExpanderTextBlockStyle" TargetType="views:TactonFormattedTextBlock">
                <Setter Property="Foreground" Value="{DynamicResource ThemeFgBrush}" />
            </Style>

            <Style x:Key="LockButtonPathStyle" TargetType="Path">
                <Setter Property="Fill" Value="{DynamicResource ThemeFgBrush}" />
            </Style>
            <!--  END Predefined styles  -->

            <Style x:Key="ExtendedTextBoxFocusVisualStyle" TargetType="Control">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Control}">
                            <Grid Margin="-3,-2">
                                <Rectangle
                                    Stroke="{DynamicResource ThemeFgBrush}"
                                    StrokeDashArray="1 2"
                                    StrokeThickness="1" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
                <Setter Property="Background" Value="{DynamicResource TextBoxBorderNormalFillBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextBoxBorderNormalFillBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="{DynamicResource TextBoxContentNormalForegroundBrush}" />
                <Setter Property="FontSize" Value="{DynamicResource TextBoxContentFontSize}" />
                <Setter Property="FontFamily" Value="{DynamicResource TextBoxContentFont}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="FocusVisualStyle" Value="{StaticResource ExtendedTextBoxFocusVisualStyle}" />
                <Style.Triggers>
                    <Trigger Property="Validation.HasError" Value="true">
                        <Setter Property="ToolTip" Value="{Binding RelativeSource={RelativeSource Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Template" Value="{StaticResource TemplateGroupBox}" />
            </Style>

        </ResourceDictionary>
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

