<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <configSections>
      <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
        <sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
            <section name="LeasedSoftwareLauncher.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
        </sectionGroup>
    </configSections>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="BasicHttpBinding_ILeaseService"  closeTimeout="00:01:00" openTimeout="00:01:00" receiveTimeout="00:01:00" sendTimeout="00:01:00" >
                    <security mode="Transport" />
                </binding>
                <binding name="BasicHttpsBinding_IClientService" closeTimeout="00:01:00" openTimeout="00:01:00" receiveTimeout="00:01:00" sendTimeout="00:01:00" >
                    <security mode="Transport" />
                </binding>
                <binding name="FlwsSoapBinding" closeTimeout="00:01:00" openTimeout="00:01:00" receiveTimeout="00:01:00" sendTimeout="00:01:00">
                    <security mode="Transport" />
                </binding>
            </basicHttpBinding>
        </bindings>
        <client>
            <endpoint address="https://license.visualcomponents.net/Client/ClientService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpsBinding_IClientService"
                contract="VcServer.IClientService" name="BasicHttpsBinding_IClientService" />
            <endpoint address="https://flexlink.visualcomponents.net/LeaseService.svc"
                binding="basicHttpBinding" bindingConfiguration="BasicHttpBinding_ILeaseService"
                contract="LeaseService.ILeaseService" name="BasicHttpBinding_ILeaseService" />
            <endpoint address="https://webapp1.flexlink.com/flws/services/FlwsServiceImplPort"
                binding="basicHttpBinding" bindingConfiguration="FlwsSoapBinding"
                contract="Flws.FlwsServiceImpl" name="FlwsServiceImplPort" />
        </client>
    </system.serviceModel>
    <applicationSettings>
        <LeasedSoftwareLauncher.Properties.Settings>
            <setting name="LaunchApplication" serializeAs="String">
                <value>VisualComponents.Engine.exe</value>
            </setting>
            <setting name="ProductName" serializeAs="String">
                <value>FL Configurator</value>
            </setting>
            <setting name="LaunchArguments" serializeAs="String">
                <value />
            </setting>
            <setting name="InfoLinkText" serializeAs="String">
                <value>Apply for Lease</value>
            </setting>
            <setting name="LauncherTitleString" serializeAs="String">
                <value>FlexLink Design Tool Lease Client</value>
            </setting>
            <setting name="InfoLinkUrl" serializeAs="String">
                <value>https://my.flexlink.com/myflexlink/applyforfldtlicense.htm?email=</value>
            </setting>
            <setting name="LocalFolder" serializeAs="String">
                <value>FlexLink\Leased Software Launcher\</value>
            </setting>
            <setting name="SettingsFile" serializeAs="String">
                <value>FldtLeaseSettings.xml</value>
            </setting>
        </LeasedSoftwareLauncher.Properties.Settings>
    </applicationSettings>


  <log4net>
    <appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="${LOCALAPPDATA}\FlexLink\FLDT\leaseclient.log" />
      <appendToFile value="true" />
      <maxSizeRollBackups value="5" />
      <rollingStyle value="Once" />
      <preserveLogFileNameExtension value="true"/>
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%utcdate{dd-MM-yyyy HH:mm:ss} %message%newline" />
      </layout>
    </appender>

    <root>
      <level value="DEBUG" />
      <appender-ref ref="RollingLogFileAppender" />
    </root>
  </log4net>
</configuration>