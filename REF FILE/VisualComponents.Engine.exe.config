	</runtime>
	
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5" />
    </startup>
    <entityFramework>
        <defaultConnectionFactory type="System.Data.Entity.Infrastructure.SqlCeConnectionFactory, EntityFramework">
            <parameters>
                <parameter value="System.Data.SqlServerCe.4.0" />
            </parameters>
        </defaultConnectionFactory>
        <providers>
            <provider invariantName="System.Data.SqlClient" type="System.Data.Entity.SqlServer.SqlProviderServices, EntityFramework.SqlServer" />
            <provider invariantName="System.Data.SqlServerCe.4.0" type="System.Data.Entity.SqlServerCompact.SqlCeProviderServices, EntityFramework.SqlServerCompact" />
        </providers>
    </entityFramework>
    <system.data>
        <DbProviderFactories>
            <remove invariant="System.Data.SqlServerCe.4.0" />
            <add name="Microsoft SQL Server Compact Data Provider 4.0" invariant="System.Data.SqlServerCe.4.0" description=".NET Framework Data Provider for Microsoft SQL Server Compact" type="System.Data.SqlServerCe.SqlCeProviderFactory, System.Data.SqlServerCe, Version=4.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91" />
        </DbProviderFactories>
    </system.data>

	<!-- CAD Import presets -->
	<CADImportPresetsSection SectionVersion="1">
		<cadpresets>
			<Preset ItemId="Workpiece">
				<cadEntries>
					<CadItem Key="IsMarkups" Value="False"/>
					<CadItem Key="IsHidenPartRead" Value="False"/>
					<CadItem Key="FeatureTree" Value="1"/>
					<CadItem Key="TesselationQuality" Value="2"/>
					<CadItem Key="ImportAs" Value="2"/>
					<CadItem Key="IsGeometryPerFace" Value="2"/>
					<CadItem Key="MetadataTypePreset" Value="Workpiece"/>
					<CadItem Key="IsFloorPlan" Value="False"/>
				</cadEntries>
			</Preset>
			<Preset ItemId="Robot">
				<cadEntries>
					<CadItem Key="IsMarkups" Value="False"/>
					<CadItem Key="IsHidenPartRead" Value="False"/>
					<CadItem Key="FeatureTree" Value="1"/>
					<CadItem Key="TesselationQuality" Value="2"/>
					<CadItem Key="ImportAs" Value="1"/>
					<CadItem Key="IsGeometryPerFace" Value="1"/>
					<CadItem Key="MetadataTypePreset" Value="Robots"/>
					<CadItem Key="IsFloorPlan" Value="False"/>
				</cadEntries>
			</Preset>
			<Preset ItemId="Floor plan">
				<cadEntries>
					<CadItem Key="IsMarkups" Value="True"/>
					<CadItem Key="IsHidenPartRead" Value="False"/>
					<CadItem Key="FeatureTree" Value="1"/>
					<CadItem Key="TesselationQuality" Value="2"/>
					<CadItem Key="ImportAs" Value="0"/>
					<CadItem Key="IsGeometryPerFace" Value="1"/>
					<CadItem Key="MetadataTypePreset" Value="Floor plan"/>
					<CadItem Key="IsFloorPlan" Value="True"/>
				</cadEntries>
			</Preset>
			<Preset ItemId="Layout">
				<cadEntries>
					<CadItem Key="IsMarkups" Value="False"/>
					<CadItem Key="IsHidenPartRead" Value="False"/>
					<CadItem Key="FeatureTree" Value="1"/>
					<CadItem Key="TesselationQuality" Value="1"/>
					<CadItem Key="ImportAs" Value="2"/>
					<CadItem Key="IsGeometryPerFace" Value="1"/>
					<CadItem Key="MetadataTypePreset" Value=""/>
					<CadItem Key="IsFloorPlan" Value="False"/>
				</cadEntries>
			</Preset>
		</cadpresets>
	</CADImportPresetsSection>

	<!--This section contains ribbon items Id that are blocked from Ribbon-->
	<blockedRibbonItemsSection SectionVersion="1">
		<blockedRibbonTools>
			<add ItemId=""/>
		</blockedRibbonTools>
		<blockedRibbonGroups>
			<add ItemId=""/>
		</blockedRibbonGroups>
		<blockedRibbonTabs>
			<add ItemId=""/>
		</blockedRibbonTabs>
		<blockedRibbonBackstageItems>
			<add ItemId=""/>
		</blockedRibbonBackstageItems>
		<blockedQuickMenuItems>
			<add ItemId=""/>
		</blockedQuickMenuItems>
		<blockedPaneItems>
			<add ItemId="ReportView"/>
			<add ItemId="DebugPanelViewModel"/>
			<add ItemId="VcGraphPerformanceTestView"/>
			<add ItemId="RobotTeach"/>
			<add ItemId="VcCellGraph"/>
			<add ItemId="VcMetadataEditor"/>
			<add ItemId="ProgramEditorViewModel"/>
		  	<add ItemId="VcProgramEditor"/>
		</blockedPaneItems>
		<blockedNonRibbonControlItems>
			<add ItemId="SettingInOptionsGeneral"/>
			<!-- uncommenting this will remove unit selection option from backstage -->
			<add ItemId="StreamingSettingInExportToAnimation" />
			<add ItemId="MadaServiceSettings" />
			<add ItemId="AnimationStreamingSettingInOptionsGeneral" />
		</blockedNonRibbonControlItems>
		<blockedToolsNotInRibbonItems>
		</blockedToolsNotInRibbonItems>
	</blockedRibbonItemsSection>

	<!--
		UX Sites:
		
				VcTabHome
				VcTabDrawing
				VcTabPaint
				VcConfigureQuickmenu
				VcConfigureToolbar
				VcDrawingToolbar
				VcTeachToolbar
				VcAuthorToolbar
				VcAuthorTreeViewContextMenu
				VcAuthorTreeViewRobotFramesContextMenu
				VcAuthorTreeViewFeaturesContextMenu
				VcAuthorTreeViewToolContextMenu
				VcAuthorTreeViewBasesContextMenu
				VcShowPanelsOrder
				SnapTypes_Default
				SnapTypes_MeasureAction
				SnapTypes_SnapPrimitiveAction
				SnapTypes_SnapPrimitiveAction_Robot
				SnapTypes_SnapOriginCommand
				SnapSettings_Default
				SnapSettings_MeasureAction
				SnapSettings_AngularDimensionCreateAction
				SnapSettings_SnapPrimitiveAction
				SnapSettings_SnapPrimitiveAction_Robot
				SnapSettings_SnapOriginCommand
				SnapSettings_AlignPrimitiveAction
				SnapFilters_Default
				SnapFilters_MeasureAction
				SnapFilters_AngularDimensionCreateAction
		-->
  	<UXSitesSection SectionVersion="1" SiteOrder="VcTabHome,FLConveyorTab,FLModulesTab,FLStructuresTab,VcTabProcess,FLControlsTab,FLLayoutTab,VcTabDrawing,FLViewTab,FLHelpTab">
      	<uxSites>
			<Site ItemId="VcTabHome">
				<uxSites>
					<Site ItemId="VcRibbonClipboard">
						<uxEntries>
							<UxItem ItemId="Copy"/>
							<UxItem ItemId="Paste"/>
							<UxItem ItemId="Delete"/>
							<UxItem ItemId ="FLPasteOffSetX"/>
							<UxItem ItemId ="FLPasteOffSetY"/>
							<UxItem ItemId ="FLPasteOffSetZ"/>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonGroup">
						<uxEntries>
							<UxItem ItemId="CreateGroup"/>
							<UxItem ItemId="UnGroup"/>
						</uxEntries>
					</Site>
					<!--added to 3d toolbar-->
					<!--<Site ItemId="VcRibbonView">
							<uxEntries>
									<UxItem ItemId="FillWorld"></UxItem>
									<UxItem ItemId="FillSelected"></UxItem>
							</uxEntries>
					</Site>-->
					<Site ItemId="VcRibbonManipulation">
						<uxEntries>
							<UxItem ItemId="SetAreaSelectModeCommand"/>
							<UxItem ItemId="Move"/>
							<UxItem ItemId="PlugAndPlay"/>
							<UxItem ItemId="Interact"/>
							<!--<UxItem ItemId="InterfacesVisibility"/>-->
							<!--UxItem ItemId="SignalsVisibility" /-->
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonTools">
						<uxEntries>
							<UxItem ItemId="Measure"/>
							<UxItem ItemId="SnapPrimitiveCommand"/>
							<UxItem ItemId="AlignPrimitiveCommand"/>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonOrigin" IconKey="RibbonGroup/rgOrigin">
						<uxEntries>
							<UxItem ItemId="FLSnapOriginWrapper"></UxItem>
							<UxItem ItemId="FLSetOriginWrapper"></UxItem>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonConnect">
						<uxEntries>
							<UxItem ItemId="Interfaces"></UxItem>
							<!--<UxItem ItemId="Signals"></UxItem>-->
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectConveyorFromList"/>
							<UxItem ItemId="FLSelectConveyor"/>
							<UxItem ItemId="FLCopySelectedConveyor"/>
							<UxItem ItemId="FLDeleteSelectedConveyor"/>
							<UxItem ItemId="FLConfigPainterSelectedConveyor"/>
							<UxItem ItemId="FLStraightSectionCurrentConveyor"/>
              <UxItem ItemId="FLFlipConveyorDirection"/>
              <UxItem ItemId="FLConveyorAutoDesigner"/>
            </uxEntries>
					</Site>
					<Site ItemId="FLComponentRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLConfigureSelectedComponent"/>
							<UxItem ItemId="FLPositionSelectedComponent"/>
							<UxItem ItemId="FLQuickAdjustSelectedComponent"/>
							<UxItem ItemId="FLToggleBuildDirection"/>
							<UxItem ItemId="FLTactonConfigPainterSelectedComponent"/>
							<UxItem ItemId="FLChangeBendOnSelectedComponent"/>
						</uxEntries>
					</Site>
					<!--<Site ItemId="VcRibbonHierarchy">
						<uxEntries>
							<UxItem ItemId="Attach"></UxItem>
							<UxItem ItemId="Detach"></UxItem>
						</uxEntries>
					</Site>-->
					<!--<Site ItemId="VcRibbonOrigin">
						<uxEntries>
							<UxItem ItemId="SnapOrigin"/>
							<UxItem ItemId="SetOrigin"/>
						</uxEntries>
					</Site>-->
				</uxSites>
			</Site>
			
			<Site ItemId="FLConveyorTab">
				<uxSites>
					<!-- Conveyor -->
					<Site ItemId="FLConveyorSelectRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectConveyorFromList"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorGenericRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectedConveyorProperties"/>
							<UxItem ItemId="FLProductManager"/>
							<UxItem ItemId="FLSelectedConveyorHeight"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorPlatformRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectedConveyorType"/>
							<UxItem ItemId="FLSelectedConveyorSubType"/>
							<UxItem ItemId="FLConvertSelectedPlatform"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorConditionMonitoringRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLToggleConditionMonitoringOnSelectedConveyor"/>
							<UxItem ItemId="FLSelectedConditionMonitoringConfiguration"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorChainRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLChainCalculation"/>
							<UxItem ItemId="FLToggleChainOnSelectedConveyor"/>
							<UxItem ItemId="FLSelectedConveyorChainType"/>
							<UxItem ItemId="FLConfigueChainOnSelectedConveyor"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorSlideRailsRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectedConveyorSliderailType"/>
							<UxItem ItemId="FLConfigueSliderailSelectedConveyor"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorPalletRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLSelectedConveyorPalletSize"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLConveyorSupportRibbonGroup">
						<uxEntries>
							<UxItem ItemId ="FLAddSupportsToSelectedConveyor"/>
							<UxItem ItemId ="FLRefreshSupportPlacement"/>
							<UxItem ItemId ="FLRemoveSupportsFromSelectedConveyor"/>
						</uxEntries>
					</Site>
					<Site ItemId="ConveyorGuideRailRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLAddGuideRailToSelectedConveyor"/>
							<UxItem ItemId="FLConfigudeGuideRailOnSelectedConveyor"/>
							<UxItem ItemId="FLRefreshGuideRailOnSelectedConveyor"/>
							<UxItem ItemId="FLRemoveGuideRailOnSelectedConveyor"/>
							<UxItem ItemId ="FLToggleLeftSideGuideRailActionItem"/>
							<UxItem ItemId ="FLToggleRightSideGuideRailActionItem"/>
						</uxEntries>
					</Site>
				</uxSites>
			</Site>

			<Site ItemId="FLModulesTab">
				<uxSites>
					<Site ItemId="FLPlatformModulesRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLPlatformModulesType"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLModuleOptionsRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLUsePlainBendsInNewModule"/>
							<UxItem ItemId="FLConfigureSegmentsOnNewModule"/>
						  	<UxItem ItemId ="FLWedgeCCDistance"/>
						</uxEntries>
					</Site>
					<Site ItemId="FLAddModulesRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLAddIShapedModule"/>
							<UxItem ItemId="FLAddZShapeModule"/>
							<UxItem ItemId="FLAddLShapeModule"/>
							<UxItem ItemId="FLAddUShapeModule"/>
							<UxItem ItemId="FLAddSShapeModule"/>
							<UxItem ItemId="FLAlpineBuilder"/>
						</uxEntries>
					</Site>
				  	<Site ItemId="FLAddWedgeModulesRibbonGroup">
						<uxEntries>
							<UxItem ItemId ="FLAddSWedgeModule"/>
							<UxItem ItemId ="FLAddCWedgeModule"/>
							<UxItem ItemId ="FLAddLeftTWedgeModule"/>
							<UxItem ItemId ="FLAddRightTWedgeModule"/>
							<UxItem ItemId ="FLMirrorConveyor"/>
						</uxEntries>
				  	</Site>
				</uxSites>
			</Site>	

		 	<Site ItemId="FLStructuresTab">
		 	</Site>
			<Site ItemId="FLProfilesMainTab" />
			<Site ItemId="FLCoreDebugTab" />

      		<Site ItemId="VcTabProcess">
          		<uxSites>
					<Site ItemId="VcRibbonManipulation" IconKey="RibbonGroup/rgManipulation">
						<uxEntries>
							<UxItem ItemId="SetAreaSelectModeCommand"></UxItem>
							<UxItem ItemId="Move"></UxItem>
							<UxItem ItemId="PlugAndPlay"></UxItem>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonTools" IconKey="RibbonGroup/rgTools">
						<uxEntries>
							<UxItem ItemId="Measure"></UxItem>
							<UxItem ItemId="SnapPrimitiveCommand"></UxItem>
							<UxItem ItemId="AlignPrimitiveCommand"></UxItem>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonProcessModelEdit" IconKey="RibbonGroup/rgProcessModelEdit">
						<uxEntries>
							<UxItem ItemId="ProductEditor"></UxItem>
							<UxItem ItemId="ProcessConfigurator"></UxItem>
							<UxItem ItemId="FlowEditor"></UxItem>
							<UxItem ItemId="FilterTransportLinks"></UxItem>
							<UxItem ItemId="ToggleGlobalFilterDebug"></UxItem>
							<UxItem ItemId="FLCloseAllProcessEditors"></UxItem>
						</uxEntries>
					</Site>
					<Site ItemId="VcRibbonConnect">
						<uxEntries>
							<UxItem ItemId="Interfaces"></UxItem>
							<UxItem ItemId="Signals"></UxItem>
						</uxEntries>
					</Site>
					<Site ItemId="FLControlsHelpRibbonGroup">
						<uxEntries>
							<UxItem ItemId="FLProcessKnowledgeBase"/>
						</uxEntries>
					</Site>
         		</uxSites>
      		</Site>
			<Site ItemId="VcProcessQuickmenu">
				<uxEntries>
					<UxItem ItemId="CloneConnect" Priority="0"></UxItem>
					<UxItem ItemId="Delete" Priority="1"></UxItem>
					<UxItem ItemId="Interfaces" Priority="2"></UxItem>
					<UxItem ItemId="Signals" Priority="3"></UxItem>
				</uxEntries>
			</Site>
			<Site ItemId="VcProcessStatements">
				<uxSites>
					<Site ItemId="ProcessStatements" TitleKey="ProcessStatements">
						<uxSites>
							<Site ItemId="RequirementStatements" TitleKey="RequirementStatements">
								<uxEntries>
									<UxItem ItemId="CreateReserveProductStatement" />
									<UxItem ItemId="CreatePropertyConditionStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="ProcessFlowStatements" TitleKey="ProcessFlowStatements">
								<uxEntries>
									<UxItem ItemId="CreateTransportInStatement" />
									<UxItem ItemId="CreateTransportOutStatement" />
									<UxItem ItemId="CreateStartTransportInStatement" />
									<UxItem ItemId="CreateStartTransportOutStatement" />
									<UxItem ItemId="CreateWaitTransportStatement" />
									<UxItem ItemId="CreateTransportPatternInStatement" />
									<UxItem ItemId="CreateBufferProductsStatement" />
									<UxItem ItemId="CreateReleaseProductReservationStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="FlowSequenceStatements" TitleKey="FlowSequenceStatements">
								<uxEntries>
									<UxItem ItemId="CreateGetFlowStepStatement" />
									<UxItem ItemId="CreateFindFlowStepStatement" />
									<UxItem ItemId="CreateSetNextFlowStepStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="AssemblyStatements" TitleKey="AssemblyStatements">
								<uxEntries>
									<UxItem ItemId="CreateGetAssemblyStatement" />
									<UxItem ItemId="CreateCheckAssemblyStatement" />
									<UxItem ItemId="CreateGetAssemblyStepPropertyStatement" />
									<UxItem ItemId="CreateConstructStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="ProcessingStatements" TitleKey="ProcessingStatements">
								<uxEntries>
									<UxItem ItemId="CreateAttachProductStatement" />
									<UxItem ItemId="CreateDetachProductStatement" />
									<UxItem ItemId="CreateCreateProductStatement" />
									<UxItem ItemId="CreateRemoveProductStatement" />
									<UxItem ItemId="CreateChangeProductTypeStatement" />
									<UxItem ItemId="CreateSetProductVisitStateStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="FlowControlStatements" TitleKey="FlowControlStatements">
								<uxEntries>
									<UxItem ItemId="CreateProcessSetPropertyStatement" />
									<UxItem ItemId="CreateProcessWhileStatement" />
									<UxItem ItemId="CreateProcessBreakStatement" />
									<UxItem ItemId="CreateProcessContinueStatement" />
									<UxItem ItemId="CreateProcessIfStatement" />
									<UxItem ItemId="CreateProcessSwitchCaseStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="MiscStatements" TitleKey="MiscStatements">
								<uxEntries>
									<UxItem ItemId="CreateAppendToListStatement" />
									<UxItem ItemId="CreateSelectProductsStatement" />
									<UxItem ItemId="CreateGetProductsStatement" />
									<UxItem ItemId="CreateMoveJointStatement" />
									<UxItem ItemId="CreateWorkStatement" />
									<UxItem ItemId="CreateGetPropertyStatement" />
									<UxItem ItemId="CreateWaitPropertyConditionStatement" />
									<UxItem ItemId="CreateSetNodeMaterialStatement" />
									<UxItem ItemId="CreateSetNodeVisibilityStatement" />
									<UxItem ItemId="CreateProcessDelayStatement" />
									<UxItem ItemId="CreateProcessPrintStatement" />
									<UxItem ItemId="CreateProcessCommentStatement" />
									<UxItem ItemId="CreateProcessHaltStatement" />
									<UxItem ItemId="CreateSendSignalStatement" />
									<UxItem ItemId="CreateWaitSignalStatement" />
									<UxItem ItemId="CreateRunRobotRoutineStatement" />
								</uxEntries>
							</Site>
							<Site ItemId="StatisticsStatements" TitleKey="StatisticsStatements">
								<uxEntries>
									<UxItem ItemId="CreateSetStatisticsStateStatement" />
									<UxItem ItemId="CreateSetStatisticsFlowStatement" />
								</uxEntries>
							</Site>
