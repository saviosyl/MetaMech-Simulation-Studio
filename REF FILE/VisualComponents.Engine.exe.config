<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<!-- Register a section handler for the log4net section -->
	<configSections>
		<section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
		<section name="blockedRibbonItemsSection" type="VisualComponents.UX.Shared.BlockedRibbonItemsSection, UX.Shared"/>
		<section name="CADImportPresetsSection" type="VisualComponents.UX.Shared.CADImportPresetsSection, UX.Shared"/>
		<section name="UXSitesSection" type="VisualComponents.UX.Shared.UXSitesSection, UX.Shared"/>
		<section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net" />
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="VisualComponents.UX.Shell.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false"/>
		</sectionGroup>
	</configSections>

	<!-- we need to set probing path form modules directories in case there are 3rd party reference to our modules -->
	<runtime>
