					<UxItem ItemId="ToggleGhostRenderCommand"/>
				</uxEntries>
			</Site>

			<Site ItemId="SnapSettings_SnapOriginCommand">
				<uxEntries>
					<UxItem ItemId="ToggleSnapPositionCommand"/>
					<UxItem ItemId="ToggleSnapOrientationCommand"/>
					<UxItem ItemId="SnapAxisCommand"/>
					<!-- This actually controls previewing of OriginMapulator. SnapPrimitiveAction knows not to render geometry ghosts when there's OriginManipulationTarget. -->
				</uxEntries>
			</Site>

			<Site ItemId="SnapSettings_AlignPrimitiveAction">
				<uxEntries>
					<UxItem ItemId="ToggleAlignFullPositionCommand"></UxItem>
					<UxItem ItemId="ToggleAlignProjectedPositionCommand"></UxItem>
					<UxItem ItemId="ToggleAlignOrientationCommand"></UxItem>
					<UxItem ItemId="ToggleGhostRenderCommand"></UxItem>
				</uxEntries>
			</Site>
	  
			<Site ItemId="SnapFilters_Default">
				<uxEntries>
					<UxItem ItemId="ToggleNormalSnapEdgeCommand"></UxItem>
					<UxItem ItemId="ToggleNormalSnapFaceCommand"></UxItem>
					<UxItem ItemId="ToggleNormalSnapBothCommand"></UxItem>
					<UxItem ItemId="ToggleNormalSnapCenterCommand" RowStart="True"></UxItem>
					<UxItem ItemId="ToggleNormalSnapFrameCommand"></UxItem>
					<UxItem ItemId="ToggleNormalSnapObjectCommand"></UxItem>
					<UxItem ItemId="ToggleNormalSnapBoundsCommand"></UxItem>
				</uxEntries>
			</Site>

			<!-- Currently only MeasureAction supports non-FreePoint picking. -->
			<Site ItemId="SnapFilters_MeasureAction">
				<uxEntries>
					<UxItem ItemId="TogglePrimitiveSnapEdgeCommand"/>
					<UxItem ItemId="TogglePrimitiveSnapFaceCommand"/>
					<UxItem ItemId="TogglePrimitiveSnapEdgeFaceCommand"/>
					<UxItem ItemId="TogglePrimitiveSnapFreePointCommand"/>
					<UxItem ItemId="TogglePrimitiveSnapObjectCommand"/>
					<UxItem ItemId="TogglePrimitiveSnapBoundsCommand"/>
				</uxEntries>
			</Site>

			<Site ItemId="SnapFilters_BalloonAnnotationCreateAction">
				<uxEntries>
					<UxItem ItemId="ToggleSnapExclusiveEdgeCommand"/>
					<UxItem ItemId="ToggleSnapExclusiveFrameCommand"/>
					<UxItem ItemId="ToggleSnapExclusiveFrameAndEdgeCommand"/>
				</uxEntries>
			</Site>

			<Site ItemId="SnapSettings_BalloonAnnotationCreateAction">
				<uxEntries>
					<UxItem ItemId="ToggleShowAllPartListItemsCommand"/>
					<UxItem ItemId="ToggleHideAllocatedPartListItemsCommand"/>
				</uxEntries>
			</Site>

			<Site ItemId="SnapFilters_AngularDimensionCreateAction">
				<uxEntries>
				</uxEntries>
			</Site>

		</uxSites>
	</UXSitesSection>

	<appSettings>
		<!-- To enable internal log4net logging specify the following appSettings key -->
		<!--<add key="log4net.Internal.Debug" value="true"/>-->

		<!-- appSettings section is used for revolution core environment settings -->

		<!-- URL of the xml file that contains information about latest version of the application
				The URL points to the xml file which can be located localy or on web-site
				local: file://S:\tmp\AutoUpdate\AutoUpdater.appName.xml
				-->

		<!-- User config folder.
						 Environment variables will be expanded. -->
		<add key="AppConfigFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\Configuration"/>
		<add key="UserConfigFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\Configuration"/>
		<!-- Deprecated -->

		<!-- Launcher application name which will be run if a license is not valid -->
		<add key="launcherAppName" value="LeasedSoftwareLauncher.exe"/>

		<!-- Semicolon delimited list of source list URLs and/or local file paths. 
			 For local file paths, %-delimited environment variables will be expanded. -->
		<add key="eCatSourceLists" value="http://files.flexlink.com/fldt/production/smart-collections.xml;http://files.flexlink.com/fldt/visualcomponents/vc_sourcelist.xml;http://files.flexlink.com/fldt/visualcomponents/vc_legacy_source_list.xml"/>
		<!-- Run the Offline Sync app at startup main app. Optional value. This key can be removed. Default value will be "false" -->
		<add key="eCatOfflineRunAtStartup" value="true"/>
		<!-- offline webpath of the eCatalog. Optional value. This key can be removed. Default value is empty -->
		<add key="eCatOfflineWebRoot" value="http://files.flexlink.com/fldt/production"/>
		<!-- Offline web xml file name. Optional value. This key can be removed. Default value is empty -->
		<add key="eCatOfflineWebXML" value="components.xml"/>
		<!-- Path of the offline Public Models folder. The application config environment variable will be expanded. -->
		<add key="OfflineEcatModelsFolder" value="%PublicModelsFolder%"/>

		<!-- Local folder containing additional eCat source list files. -->
		<add key="eCatSourceListFolder" value="Sources"/>

		<!-- Local path to eCat user data. 
						 Environment variables will be expanded. -->
		<add key="eCatDataFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\eCatalog\"/>

		<!-- Name of the eCat database file. -->
		<add key="eCatDatabaseFileOld" value="..\Essentials\4.0\eCatalog_4.0.5.sdf"/>

		<!-- Microsoft SQL Server connection string. If the value contains a connection string, it
				will be used instead of eCatDatabaseFile option. Database is created automatically. -->
		<add key="eCatDatabaseServer" value="" />

		<add key="eCatDatabaseFile" value="eCatalog_4.1.0.sdf"/>
		
		<!-- Path of the User's "My Documents" product folder. Environment variables will be expanded. -->
		<add key="MyDocumentsProductFolder" value="%MYDOCUMENTS%\FlexLink\Design Tool" />
		<!-- Local path to the eCat local copy folder. Environment variables will be expanded. -->
		<add key="LocalCopyFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\Local Copies"/>

		<!-- Path of the "My Models"" folder. Environment variables will be expanded. -->
		<add key="MyModelsFolder" value="%MyDocumentsProductFolder%\My Models"/>
		<!-- Path of the "My Commands" folder. Environment variables will be expanded. -->
		<add key="MyCommandsFolder" value="%MyDocumentsProductFolder%\My Commands"/>
		<!-- Path of the "My Materials" folder. Environment variables will be expanded. -->
		<add key="MyMaterialsFolder" value="%MyDocumentsProductFolder%\My Materials"/>
		<!-- Path of the "My Templates" folder. Environment variables will be expanded. -->
		<add key="MyTemplatesFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\My Templates" />
        <!-- Path of the "My Animations" folder. Environment variables will be expanded. -->
        <add key="MyAnimationsFolder" value="%MyDocumentsProductFolder%\My Animations" />
		
		<!-- Path of the Public Models folder. Environment variables will be expanded. -->
    	<add key="PublicModelsFolder" value="%COMMONDOCUMENTS%\FlexLink\Design Tool\Models"/>

		<add key="DownloadedFolder" value="%LOCALAPPDATA%\FlexLink\FLDT\Current Layout"/>
    
		<!-- value determining how the cad loader should search for corresponding application material -->
		<!-- -1 = negative value means that the CAD reader will always create a new material for each material found on the cad file-->
		<!-- 0 =  0 values means that cad reader wil use an application material that has the minimun color distance-->
		<!-- +1 = value higher than 0 means that cad reader will use that as a minimun distance tolerance. If no application material has lower value, then new material is created (recommended value = 10)-->
		<add key="CADReaderColorMiniumDistanceTolerance" value="0"/>

		<!-- PDF 3D background color red component (values between 0 and 1) -->
		<add key="PDFBackgroundRed" value="0.35"/>
		<!-- PDF 3D background color red component (values between 0 and 1) -->
		<add key="PDFBackgroundGreen" value="0.35"/>
		<!-- PDF 3D background color red component (values between 0 and 1) -->
		<add key="PDFBackgroundBlue" value="0.35"/>

		<!-- this defines how the PDF export action populates the bill of materials-->
		<!-- true = indicates that it uses BOMname/BOMdescription component built-in properties -->
		<!-- false = indicates that it uses PDF_DESCRIPTION/PDF_GROUPDESCRIPTION/PDF_GROUPNAME component properties (non-built-in) -->
		<add key="PDFExportUsesComponentsBOM" value="false"/>

		<!-- This defines how New Drawing generation (AddNewDrawingViewCommand) works. -->
		<!-- 0 = user choose the camera mode for the drawing generation -->
		<!-- 1 = user choose the camera mode for the drawing generation BUT default camera mode is orthographic -->
		<!-- 2 = drawing generation will use only orthographic camara mode-->
		<add key="DrawingGenerationMode" value="2"/>

        <!-- Local folder containing python editor settings. -->
        <add key="PythonEditor" value="Python Editor"/>
        <!-- Local folder containing python editor/code snippets scripts-->
        <add key="CodeSnippets" value="Code Snippets"/>
        <!-- Local folder containing python editor/auto complete information-->
        <add key="PythonAutoComplete" value="Auto Complete"/>
        <!-- Local folder containing python editor/theme defintion-->
        <add key="PythonTheme" value="Theme"/>
		
		<!-- Local folder containing drawing templates. -->
		<add key="DrawingTemplates" value="Drawing Templates"/>

		<!-- Help folder, url format, and default document. -->
		<add key="HelpDocumentation" value="Help"/>
		<add key="HelpDocumentationUrlFormat" value="%LANGUAGE%/{0}"/>
		<add key="HelpDocumentationHome" value="Essentials_Help_File.htm"/>

		<!-- Help for paste command (just examples) -->
		<add key="PasteHelpUrl" value="Tasks/Workspace/Clipboard.htm#paste"/>
		<add key="PasteHelpUrl.English" value="Tasks/Workspace/Clipboard.htm#paste"/>

		<!--DO NOT EDIT these are runtime generated and shown here for verbosity only -->
		<add key="BaseDirectory" value=""/>

		<!-- The license settings relative folder name. It should not contain any folder separators -->
		<add key="LicenseSettingFolder" value="License Setting"/>

		<!-- Product license file name which is located at "LicenseSettingFolder" folder -->
		<add key="ProductLicenseFile" value="MainLicenseConfiguration.xml"/>

		<!-- The floating license relative folder name -->
		<!--add key="FloatingLicenseServerFolder" value="License Setting\Floating License Server Setting"/-->

		<!-- The floating license file name which is located at "FloatingLicenseServerSetting" folder -->
		<!--add key="FloatingLicenseServerFile" value="FloatingLicenseServerConfiguration.xml"/-->
		
		<!-- Whether to hide the renewal warning shown in the ribbon when the current activation is about to expire -->
		<add key="LicenseHideRenewalWarning" value="True"/>

		<!-- Optional value. This key can be removed. Default value will be "Dark Theme" -->
		<add key="DefaultTheme" value="Dark Theme"/>

		<!-- Optional value. This key can be removed. Default value will be "English" -->
		<add key="DefaultLanguage" value="English"/>

		<!-- Set Code Page for converting old strings to Unicode. Default is 0 and indicates that it will use current user's Code Page.
		The Code Page value can be set according https://msdn.microsoft.com/en-us/library/windows/desktop/dd317756(v=vs.85).aspx
		For example: 932 is ANSI/OEM Japanese -->
		<add key="CodePageForOldAsciiString" value="0" />
		
		<!-- Optional value. This key can be removed. Default value will be oResource -->
		<add key="OEMResourceFolderName" value="OEM Resource"/>

		<!-- Optional value. This key can be removed. Default value will be False -->
		<!-- If it's false then no resources will be loaded from OEMResourceFolderName folder -->
		<add key="CanAppResourceBeCustomizedByOEM" value="True"/>

		<!-- Enable or disable joint limit detection.True is enabled and False is disabled-->
		<add key="IsJointLimitDetectionEnabled" value="False"/>

		<!-- Enable or disable simulation clock visibility.True is visible and False is hidden.-->
		<!--This key can be removed. Default value will be FALSE -->
		<add key="IsSimulationClockVisible" value="true"/>

		<!-- Enable or disable simulation clock display mode visibility.True is visible and False is hidden.-->
		<!--This key can be removed. Default value will be FALSE -->
		<add key="IsClockDisplayModeSettingVisible" value="true"/>

		<!-- Set Rotation coordinate system. The values are either "ABC" or "XYZ" .-->
		<!--This key can be removed. Default value will be "ABC" -->
		<add key="RotationCoordinateSystem" value="XYZ"/>

		<!-- Show or Hide rotation manipulation ring in 3d world.True is visible and False is hidden.-->
		<add key="IsRotationManipulationRingVisible" value="false"/>

		<!-- Show or Hide default view cube in 3d world.True is visible and False is hidden.-->
		<add key="IsDefaultViewCubeVisible" value="true"/>

		<!-- Show or Hide Ribbon.True is visible and False is hidden.-->
		<add key="IsRibbonVisible" value="true" />
	
		<!-- Show or Hide child to parent indicator arrow in 3d world.True is visible and False is hidden.-->
		<add key="IsChildToParentIndicatorArrowVisible" value="false"/>

		<!-- Hide or Show BOM properties in component property panel. False is hide and True is show.-->
		<!--This key can be removed. Default value will be false. -->
		<add key="VisibleBomProperties" value="false"/>

		<!-- Enable or disable Video Record button visibility.True is visible and False is hidden.-->
		<!--This key can be removed. Default value will be FALSE -->
		<add key="IsVideoRecordingVisible" value="True"/>

		<!-- Hide or show trailing zero.If Null this setting will not be used.Instead user defined setting will be applied-->
		<add key="ShowTrailingZero" value="true"/>

		<!-- Simulation control visibility state.If Null this setting will not be used.Instead user defined setting will be applied-->
		<add key="IsSimulationControlVisible" value="true"/>

		<!-- Decimal precision to be used.If Null this setting will not be used.Instead user defined setting will be applied-->
		<add key="DecimalPrecision" value="2"/>

		<!-- Unit family to be used.If Null this setting will not be used. Instead user defined setting will be applied-->
		<add key="UnitFamily" value="Metric"/>

		<!-- Dimension and Annotations Display accuracy to be used. If Null this setting will not be used.
						 Instead user defined setting will be applied. -->
		<add key="DimensionsAndAnnotationsAccuracy" value="0"/>

		<!--Enable or disable PnP Rotation handle And Hierarchy Indicator Arrow Visibility.-->
		<!-- Optional value. This key can be removed. Default value will be true -->
		<add key="IsPnPHandleVisible" value="False"/>
		<!-- Enables or disables auto PnP-->
		<add key="IsAutoPnPEnable" value="True"/>

		<!-- Scroll Wheel Zoom mode default value is set to keep center of interest. -->
		<!-- Optional value. This key can be removed. Default value will be FALSE. -->
		<add key="ScrollWheelZoomModeIsCenterOfInterest" value="False" />
		
		<!--OEM specific settings-->
		<add key="IsAccountBackStagePageVisible" value="True"/>
		<add key="IsInfoBackStagePageVisible" value="True"/>
		<add key="IsExportToStaticPDFInDrawingVisible" value="False"/>
		<!-- Turn on/off additional light which direction is always facing to the viewpoint.
						 True is enabled and False is disabled. Default value is True. -->
		<add key="3DSettingsHeadlight" value="False"/>
		<!-- Enable or disable "Speed" value at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_Speed" value="False"/>
		<!-- Enable or disable "Acceleration" value at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_Acceleration" value="False"/>
		<!-- Enable or disable "Singularity" value at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_Singularity" value="False"/>
		<!-- Enable or disable "Color Highlight" value at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_ColorHighlight" value="False"/>
		<!-- Enable or disable "Stop At limit" detection at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_StopAtLimits" value="False"/>
		<!-- Enable or disable "Message Panel Output" value at Program tab -> Limits section. True is enabled and False is disabled-->
		<add key="ProgramLimits_MessagePanelOutput" value="False"/>
		<!--End OEM specific settings-->

		<!--Context related setting-->
		<add key="ToggleContextFromRibbon" value="True"/>		
		<!--if True dockmanager layout are independent of context meaning each context have its own layout.False otherwise.-->
		<add key="AllowIndependentContextLayout" value="False" />
		<!--if True restoring window in one context will restore pane for all context.If false it restore  only the current context.-->
		<add key="RestoreDockmanagerLayoutForAllContext" value="True" />
		<add key="ToggleContextualRibbonTabs" value="False"/>

		<!-- The launcher related settings -->
		<add key="ProductName" value="FlexLink Design Tool" />
		<add key="SFProductName" value="FlexLink Design Tool"/>
		<add key="SFCompanyName" value="FlexLink"/>
		<add key="SFCompanyURL" value="http://www.flexlink.com"/>

		<!-- Define which messages are shown in Output window. 
						 Possible levels: ERROR, MESSAGE, DEBUG.
						 Note: in native side this value is also passed to rMessageContext. -->
		<add key="ConsoleViewMessageLevel" value="MESSAGE"/>
		<add key="ConsoleViewCollapseDuplicates" value="True"/>


        <add key="FeatureTreeAutoSharing" value="False" />
        <add key="FeatureTreeSkipDuplicateUpdates" value="True" />
        <add key="FeatureTreeAutoSharingDebug" value="False" />

        <add key="PhysicsCableMaxCylinders" value="55" />
        <add key="PhysicsCableDebug" value="False" />

		<!-- Auto save initial state on play. Shortcut: Control + Alt + Shift + I. -->
		<add key="AutoSaveState" value="True" />

		<add key="AnimationStreamingEnabled" value="False" />
		<add key="AnimationStreamingPort" value="6688" />

		<!-- Drawing Generation: 0 == no optimization,  0 > RenderTileOptimization -->
		<add key="DrawingGenerationRenderDefaultValue" value="10" />
		
		<!-- Conveyor path accelerationis enabled  with value true and disabled with value false--> 
		<add key="UsePathAcceleration" value="false" /> 
		
		<!-- Optional value. If true, ShowDialog will open a modal window. If false, it will open a non-modal window and temporarily block interaction with the application's main UI. -->
		<!--<add key="BusyScopeShowDialogIsModal" value="False" />-->

		<!-- key="ShowDebug" value="True" /-->

		<!-- Export related settings -->
		<add key="CanExportToMP4" value="true" />
		<add key="OnlineStoreUploadDwgUrl" value="https://webprod.flexlink.com/flws/api/v1" />
		<add key="OnlineStoreUploadDwgUrlDebug" value="https://wdev2.flexlink.com/flws/api/v1" />
	</appSettings>
	<log4net> 
		<appender name="RollingLogFileAppender" type="log4net.Appender.RollingFileAppender">
			<file value="${LOCALAPPDATA}\FlexLink\FLDT\fldt-full.log"/>
			<appendToFile value="true"/>
			<maxSizeRollBackups value="10"/>
			<rollingStyle value="Once"/>
			<preserveLogFileNameExtension value="true"/>
			<layout type="log4net.Layout.PatternLayout">
				<header value="[Header] "/>
				<footer value="[Footer] "/>
				<conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline"/>
			</layout>
		</appender>

		<!--appender name="Log2ConsoleAppender" type="log4net.Appender.RemotingAppender" >
			<sink value="tcp://localhost:7070/LoggingSink"/>
			<lossy value="false"/>
			<bufferSize value="1"/>
		</appender-->

		<root>
			<level value="WARN"/>
			<appender-ref ref="RollingLogFileAppender"/>
			<!--appender-ref ref="Log2ConsoleAppender" /-->
			<!-- Note: ConsoleView messages are also filtered with "ConsoleViewMessageLevel" -->
			<!--<appender-ref ref="ConsoleViewAppender"/>-->
		</root>

		<logger name="FlexLink">
		  <level value="INFO"/>
		</logger>

		<logger name="Ux.FlexLink">
			<level value="INFO"/>
		</logger>

		<logger name="eCatUpdater">
			<level value="INFO"/>
		</logger>

		<logger name="ConsoleViewModel">
			<level value="ERROR"/>
		</logger>


		<!-- TFS 18144 Log: Remove performance WARN logs [ChangeRequest] -->
		<logger name="VisualComponents.Revolution.NetProxyWrapper">
			<level value="FATAL" />
		</logger>
		<logger name="VisualComponents.UX.Viewport.Direct3DViewportView">
			<level value="ERROR" />
		</logger>
	</log4net>

	<applicationSettings>
		<VisualComponents.UX.Shell.Properties.Settings>
		</VisualComponents.UX.Shell.Properties.Settings>
	</applicationSettings>
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.5"/>
	</startup>
	<system.serviceModel>
		<bindings>
			<basicHttpBinding>
				<binding name="BasicHttpsBinding_IClientService">
					<security mode="Transport"/>
				</binding>
				<binding name="FlwsSoapBinding"
								closeTimeout="00:03:00" openTimeout="00:03:00"
								receiveTimeout="00:10:00" sendTimeout="00:02:00" allowCookies="false"
								maxBufferPoolSize="2147483647" maxReceivedMessageSize="2147483647">
					<security mode="Transport"/>
				</binding>
				<binding name="FldtLayoutConverterPortBinding"  sendTimeout="00:03:00" >
					<security mode="Transport"/>
				</binding>
				<binding name="FldtLayoutConverterPortBinding-Debug" sendTimeout="00:03:00"/>
			</basicHttpBinding>
		</bindings>
		<client>
			<endpoint address="https://license.visualcomponents.net/Client/ClientService.svc"
				binding="basicHttpBinding" bindingConfiguration="BasicHttpsBinding_IClientService"
				contract="VcServer.IClientService" name="BasicHttpsBinding_IClientService"/>
			<endpoint address="https://ws.flexlink.com/flws/services/FlwsServiceImplPort"
				binding="basicHttpBinding" bindingConfiguration="FlwsSoapBinding"
				contract="Flws.FlwsServiceImpl" name="FlwsServiceImplPort"/>
			<endpoint address="https://wdev2.flexlink.com/flws/services/FlwsServiceImplPort"
				binding="basicHttpBinding" bindingConfiguration="FlwsSoapBinding"
				contract="Flws.FlwsServiceImpl" name="FlwsServiceImplPort-Debug"/>
			<endpoint address="https://layout-converter.flexlink.com/fldtconverter/ws/v1"
				binding="basicHttpBinding" bindingConfiguration="FldtLayoutConverterPortBinding"
				contract="FldtLayoutConverter.FldtLayoutConverter" name="FldtLayoutConverterPort"/>
			<endpoint address="http://layout-converter-stage.flexlink.org/fldtconverter/ws/v1"
				binding="basicHttpBinding" bindingConfiguration="FldtLayoutConverterPortBinding-Debug"
				contract="FldtLayoutConverter.FldtLayoutConverter" name="FldtLayoutConverterPort-Debug"/>
			<endpoint address="https://appupdate.flexlink.com/clientstarterservice/clientstarterservice"
				binding="basicHttpBinding" bindingConfiguration="FlwsSoapBinding"
				contract="ClientStarterService.ClientStarterService" name="ClientStarterServiceImplPort" />


			<!-- Service reference from Ux.FlexLink.Core -->
			<endpoint address="https://ws.flexlink.com/flws/services/FlwsServiceImplPort"
				binding="basicHttpBinding" bindingConfiguration="FlwsSoapBinding"
				contract="FlexLink.WebService.FlwsServiceImpl" name="FlwsServiceImplPort"/>
		</client>
	</system.serviceModel>

	<system.net>
		<defaultProxy enabled="true" useDefaultCredentials="true"/>    
		<!--defaultProxy>
		<proxy proxyaddress="http://yourproxy.company.com:80" 
							 usesystemdefault="True"
							 autoDetect="False"/>
		</defaultProxy-->
		<!--defaultProxy>
			<proxy usesystemdefault="true"/>
		</defaultProxy-->
	</system.net>
</configuration>
